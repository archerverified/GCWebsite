{
  "compilerOptions": {
    /* Language / environment — matches the Vite (esbuild/swc) toolchain */
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "useDefineForClassFields": true,

    /* Bundler resolution (Vite owns emit; tsc only type-checks) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,

    /* Moderate strictness — on, but not maximal (no unused-locals/params, no
       noUncheckedIndexedAccess/exactOptionalPropertyTypes pedantry) */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    /* Keep third-party .d.ts noise out of the gate */
    "skipLibCheck": true
  },
  "include": ["src"]
}
